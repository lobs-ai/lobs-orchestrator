#!/usr/bin/env python3
"""
Worker agent management CLI.

Usage:
    bin/manage-workers list                    # List all provisioned workers
    bin/manage-workers provision <proj>        # Provision worker for project
    bin/manage-workers provision <proj> --restart  # Provision + restart gateway
    bin/manage-workers sync <proj>             # Sync templates to worker
    bin/manage-workers sync-all                # Sync templates to all workers
    bin/manage-workers cleanup <proj>          # Remove worker for project
    bin/manage-workers restart                 # Restart OpenClaw gateway
"""

import sys
from pathlib import Path

# Add orchestrator to path
sys.path.insert(0, str(Path(__file__).parent.parent))

from orchestrator.core.agents import AgentManager
from orchestrator.config import ORCHESTRATOR_REPO_PATH


def main():
    template_dir = ORCHESTRATOR_REPO_PATH / "worker-template"
    manager = AgentManager(template_dir)
    
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    
    command = sys.argv[1]
    
    if command == "list":
        workers = manager.list_workers()
        if not workers:
            print("No workers provisioned.")
        else:
            print("Provisioned workers:")
            for project_id in workers:
                print(f"  - worker-{project_id} (project: {project_id})")
    
    elif command == "provision":
        if len(sys.argv) < 3:
            print("Usage: bin/manage-workers provision <project-id> [--restart]")
            sys.exit(1)
        
        project_id = sys.argv[2]
        should_restart = "--restart" in sys.argv
        
        print(f"Provisioning worker for {project_id}...")
        
        if manager.provision_worker(project_id, force=False, register=True):
            print(f"✅ Worker provisioned: worker-{project_id}")
            print("⚠️  Agent registered in openclaw.json")
            
            if should_restart:
                print("Restarting gateway...")
                if manager.restart_gateway():
                    print("✅ Gateway restarted - worker is now available")
                else:
                    print("❌ Failed to restart gateway - restart manually")
                    sys.exit(1)
            else:
                print("ℹ️  Run 'openclaw gateway restart' or 'bin/manage-workers restart' for agent to be available")
        else:
            print(f"❌ Failed to provision worker for {project_id}")
            sys.exit(1)
    
    elif command == "sync":
        if len(sys.argv) < 3:
            print("Usage: bin/manage-workers sync <project-id>")
            sys.exit(1)
        
        project_id = sys.argv[2]
        print(f"Syncing templates to worker-{project_id}...")
        
        if manager.sync_worker_templates(project_id):
            print(f"✅ Templates synced for worker-{project_id}")
        else:
            print(f"❌ Failed to sync templates for {project_id}")
            sys.exit(1)
    
    elif command == "sync-all":
        workers = manager.list_workers()
        if not workers:
            print("No workers to sync.")
            sys.exit(0)
        
        print(f"Syncing templates to {len(workers)} workers...")
        failed = []
        
        for project_id in workers:
            if manager.sync_worker_templates(project_id):
                print(f"  ✅ {project_id}")
            else:
                print(f"  ❌ {project_id}")
                failed.append(project_id)
        
        if failed:
            print(f"\nFailed to sync: {', '.join(failed)}")
            sys.exit(1)
        else:
            print(f"\n✅ All workers synced successfully")
    
    elif command == "cleanup":
        if len(sys.argv) < 3:
            print("Usage: bin/manage-workers cleanup <project-id>")
            sys.exit(1)
        
        project_id = sys.argv[2]
        print(f"Removing worker for {project_id}...")
        
        if manager.cleanup_worker(project_id):
            print(f"✅ Worker removed: worker-{project_id}")
        else:
            print(f"❌ Failed to remove worker for {project_id}")
            sys.exit(1)
    
    elif command == "restart":
        print("Restarting OpenClaw gateway...")
        if manager.restart_gateway():
            print("✅ Gateway restarted successfully")
        else:
            print("❌ Failed to restart gateway")
            sys.exit(1)
    
    else:
        print(f"Unknown command: {command}")
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
