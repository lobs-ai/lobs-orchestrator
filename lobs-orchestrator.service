[Unit]
Description=Lobs Orchestrator Service

[Service]
Type=simple
WorkingDirectory=/home/rafe/lobs-orchestrator
ExecStart=/bin/bash -c 'source .venv/bin/activate && exec python3 main.py'
Restart=always
RestartSec=10
StandardOutput=append:/home/rafe/.openclaw/logs/lobs-orchestrator.log
StandardError=append:/home/rafe/.openclaw/logs/lobs-orchestrator.err
Environment="PATH=/home/rafe/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
